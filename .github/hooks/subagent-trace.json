[
  {
    "type": "command",
    "event": "SubagentStart",
    "command": "echo \"[$(date '+%Y-%m-%d %H:%M:%S')] SUBAGENT_START: $AGENT_NAME | timestamp: $(date +%s)\" >> .github/logs/agent-trace.log",
    "osx": "echo \"[$(date '+%Y-%m-%d %H:%M:%S')] SUBAGENT_START: $AGENT_NAME | timestamp: $(date +%s)\" >> .github/logs/agent-trace.log",
    "timeout": 5
  },
  {
    "type": "command",
    "event": "SubagentStop",
    "command": "echo \"[$(date '+%Y-%m-%d %H:%M:%S')] SUBAGENT_STOP: $AGENT_NAME | result: $AGENT_RESULT | duration: $AGENT_DURATION\" >> .github/logs/agent-trace.log",
    "osx": "echo \"[$(date '+%Y-%m-%d %H:%M:%S')] SUBAGENT_STOP: $AGENT_NAME | result: $AGENT_RESULT | duration: $AGENT_DURATION\" >> .github/logs/agent-trace.log",
    "timeout": 5
  }
]
